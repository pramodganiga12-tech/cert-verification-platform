# System Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_IPFS_GATEWAY=http://localhost:8080/ipfs

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (Must be 32 bytes / 64 hex characters)
CERTIFICATE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DATABASE_PATH=./database/platform.sqlite

# Blockchain / Hardhat / Ganache
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# IPFS Local Config
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
