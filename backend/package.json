{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx --no-install tsx watch src/index.ts",
    "build": "npx --no-install tsc",
    "start": "node dist/index.js",
    "typecheck": "npx --no-install tsc --noEmit",
    "lint": "npx --no-install eslint src --ext .ts",
    "test": "npx --no-install tsx --test src/test/*.test.ts",
    "db:migrate": "npx --no-install tsx ../database/migrate.ts",
    "db:seed": "npx --no-install tsx ../database/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
